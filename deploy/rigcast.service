[Unit]
Description=Rigcast GPU workload daemon
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service tailscaled.service

[Service]
Type=simple
User=rigcast
Group=rigcast
SupplementaryGroups=docker
StateDirectory=rigcast
StateDirectoryMode=0700
EnvironmentFile=/etc/rigcast/daemon.env
ExecStart=/usr/local/bin/rigcast daemon --data-dir /var/lib/rigcast
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
